# Local mode: offline editing, loopback only, private files in .data/.
WORK_PLANNER_MODE=local
PORT=8765
WORK_PLANNER_DATA_DIR=.data

# Cloud mode needs BOTH a private Blob token and a generated access-key hash.
# Set these in Vercel Environment Variables, never in client JavaScript or Git.
# WORK_PLANNER_MODE=cloud
# BLOB_READ_WRITE_TOKEN=
# WORK_PLANNER_ACCESS_KEY_HASH=
# WORK_PLANNER_STORAGE_PREFIX=work-planner
