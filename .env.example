# Local mode: offline editing, loopback only, private files in .data/.
WORK_PLANNER_MODE=local
PORT=8765
WORK_PLANNER_DATA_DIR=.data

# Cloud mode: recommended dedicated Neon Postgres database plus an app-key hash.
# Set secrets in Vercel Environment Variables, never in client JavaScript or Git.
# WORK_PLANNER_MODE=cloud
# WORK_PLANNER_STORAGE=postgres
# DATABASE_URL=
# Alternatively use WORK_PLANNER_DATABASE_URL (takes precedence over DATABASE_URL).
# WORK_PLANNER_DATABASE_URL=
# WORK_PLANNER_ACCESS_KEY_HASH=
# WORK_PLANNER_STORAGE_PREFIX=work-planner
# Initialize the database schema once with: npm run setup:database
# When running database-backed development locally, set VERCEL_ENV=development
# so its namespace differs from production. Local mode above always uses files.
# VERCEL_ENV=development

# Optional legacy cloud storage: private Vercel Blob.
# If WORK_PLANNER_STORAGE is omitted in cloud mode, Blob remains the default.
# WORK_PLANNER_STORAGE=blob
# BLOB_READ_WRITE_TOKEN=
# Selecting another backend does not transfer data or provide an outage fallback.
