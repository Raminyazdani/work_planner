{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{public,vendor}/**",
      "maxDuration": 120
    }
  },
  "rewrites": [{"source": "/(.*)", "destination": "/api/index"}]
}
